---
import BaseLayout from './BaseLayout.astro';

// Shared chrome for the blog list + detail pages. Now delegates to BaseLayout
// (nav/header + footer + fonts + OgMeta + hreflang x6 + x-default), so blog
// pages get the same shared chrome as every other page type. Keeps the `blog`
// main class the blog pages' pragmatic styles hang off. `path` is the
// locale-less route suffix (e.g. "blogs/" or "blogs/<slug>/").
interface Props {
  locale: string;
  title: string;
  description?: string;
  path: string;
}
const { locale, title, description, path } = Astro.props;
---
<BaseLayout locale={locale} title={title} description={description} path={path} mainClass="blog">
  <slot />
</BaseLayout>
