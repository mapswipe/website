{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "build"
    ],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "baseUrl": ".",
        "paths": {
            "components/*": [
                "src/components/*"
            ],
            "layouts/*": [
                "src/layouts/*"
            ],
            "lib/*": [
                "src/lib/*"
            ],
            "i18n/*": [
                "src/i18n/*"
            ],
            "styles/*": [
                "src/styles/*"
            ],
            "pages/*": [
                "src/pages/*"
            ],
            "packages/*": [
                "packages/*"
            ]
        }
    }
}