---
import BaseLayout from './BaseLayout.astro';

// Chrome for the project detail page. Delegates to BaseLayout so project
// pages get the shared nav/footer/fonts + OgMeta + hreflang. hreflang points at
// the SAME project in every locale (path = projects/<firebaseId>/), matching
// the Next app's URL scheme.
interface Props {
    locale: string;
    firebaseId: string;
    title: string;
    mainClass?: string; // the page's CSS-Module root class (e.g. styles.project)
}
const { locale, firebaseId, title, mainClass } = Astro.props;
---
<BaseLayout locale={locale} title={title} path={`projects/${firebaseId}/`} mainClass={mainClass}>
    <slot />
</BaseLayout>
