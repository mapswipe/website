---
import BaseLayout from 'layouts/BaseLayout.astro';
import Heading from 'components/Heading.astro';
import { DEFAULT_LOCALE } from '../i18n';
// CSS Modules recovered from the Next app: the page module (pages/404/
// styles.module.css, co-located here as 404.module.css) + Link/ImageWrapper
// component modules.
import styles from './404.module.css';
import linkStyles from 'components/Link.module.css';
import imageStyles from 'components/ImageWrapper.module.css';

// 404 page (Next: src/pages/404/index.tsx). Locale-less single page. The Next
// version's copy was hardcoded English, so it stays English here. Rendered with
// the default-locale (en) chrome; hreflang disabled (no per-locale 404 set).
// Astro emits this to dist/404.html.
---
<BaseLayout
    locale={DEFAULT_LOCALE}
    title="404 | MapSwipe"
    path="404/"
    hreflang={false}
>
    <div class={styles.fourHundredFour}>
        <div class={styles.leftContent}>
            <div class={styles.headingContainer}>
                <Heading size="extraLarge">404</Heading>
                <Heading font="normal">
                    This area has not been swiped yet!
                </Heading>
            </div>
            <a class:list={[linkStyles.link, linkStyles.buttonTransparent]} href="/">Go back to home</a>
        </div>
        <div class={styles.rightContent}>
            <div class={imageStyles.imageWrapper}>
                <img class={imageStyles.image} src="/img/404.svg" alt="404 Page" />
            </div>
        </div>
    </div>
</BaseLayout>
