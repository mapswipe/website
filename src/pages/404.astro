---
import BaseLayout from 'layouts/BaseLayout.astro';
import Heading from 'components/Heading/index.astro';
import Link from 'components/Link/index.astro';
import ImageWrapper from 'components/ImageWrapper/index.astro';
import { DEFAULT_LOCALE, LOCALES } from '../i18n';
// Page module recovered from the Next app (pages/404/styles.module.css,
// co-located here as 404.module.css); chrome via shared components.
import styles from './404.module.css';

// 404 page (Next: src/pages/404/index.tsx). Locale-less single page. The Next
// version's copy was hardcoded English, so it stays English here. Rendered with
// the default-locale (en) chrome; hreflang disabled (no per-locale 404 set).
// Astro emits this to dist/404.html.
---
<BaseLayout
    locale={DEFAULT_LOCALE}
    title="404 | MapSwipe"
    path="404/"
    hreflang={false}
>
    {/* GH Pages serves this page for ANY unknown path — including locale-less
        deep links like /projects/<id>/. Those aren't 404s: forward them into
        the remembered locale (Navbar choice) or the default. A path whose
        first segment IS a locale is a genuine 404 and renders below (the
        rewritten URL always has a locale prefix, so this cannot loop). */}
    <script is:inline define:vars={{ locales: LOCALES, fallback: DEFAULT_LOCALE }}>
        (function () {
            const seg = location.pathname.split('/')[1];
            if (locales.indexOf(seg) !== -1) {
                return;
            }
            let locale = fallback;
            try {
                const stored = localStorage.getItem('mapswipe-locale');
                if (locales.indexOf(stored) !== -1) {
                    locale = stored;
                }
            } catch {
                // storage unavailable — fall back
            }
            location.replace(`/${locale}${location.pathname}${location.search}${location.hash}`);
        })();
    </script>
    <div class={styles.fourHundredFour}>
        <div class={styles.leftContent}>
            <div class={styles.headingContainer}>
                <Heading size="extraLarge">404</Heading>
                <Heading font="normal">
                    This area has not been swiped yet!
                </Heading>
            </div>
            <Link
                variant="buttonTransparent"
                href="/"
            >Go back to home</Link>
        </div>
        <div class={styles.rightContent}>
            <ImageWrapper
                src="/img/404.svg"
                alt="404 Page"
            />
        </div>
    </div>
</BaseLayout>
