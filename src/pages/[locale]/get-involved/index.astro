---
import type { GetStaticPaths } from 'astro';
import BaseLayout from 'layouts/BaseLayout.astro';
import Hero from 'components/Hero/index.astro';
import Section from 'components/Section/index.astro';
import CenteredCard from 'components/CenteredCard/index.astro';
import Heading from 'components/Heading/index.astro';
import Link from 'components/Link/index.astro';
import ImageWrapper from 'components/ImageWrapper/index.astro';
import { getT, LOCALES } from '../../../i18n';
import { selectPaths } from 'packages/astro-incremental-static/src/index.ts';
// Page module + the Link/ImageWrapper CSS Modules recovered from the Next
// app; the chrome comes from the shared Hero/Section/CenteredCard components.
import styles from './styles.module.css';
import imageStyles from 'components/ImageWrapper/styles.module.css';

// Get-involved page. One static, translated variant per locale —
// /<locale>/get-involved/ — faithful to the Next Pages-Router page. Uses shared
// chrome (BaseLayout) + recovered Hero/Section/CenteredCard CSS Modules.
//
// The page renders NO project/blog data — its only content input is the
// `get-involved` i18n namespace, which lives in the repo-root locales/
// and is folded into the orchestration's codeHash. So its propsData is a stable
// per-locale constant: the propsHash never changes on a project/blog *data*
// edit → the page SKIPS on incremental data builds (matching Next, which never
// re-renders static pages on a data change). A translation edit bumps codeHash
// → the whole site (this page included) rebuilds anyway, so tracking
// translations here would be redundant.
export const getStaticPaths = (async () =>
    selectPaths('get-involved', LOCALES.map((locale) => ({
        key: `${locale}/get-involved`,
        params: { locale },
        propsData: { page: 'get-involved', locale },
    })))) satisfies GetStaticPaths;

const { locale } = Astro.params;
const t = await getT(locale!, 'get-involved');
const title = String(t('get-involved-tab-head'));
---
<BaseLayout locale={locale!} title={title} path="get-involved/" activePath="get-involved" mainClass={styles.getInvolved}>
    {/* Hero */}
    <Hero title={t('hero-title')} class={styles.hero}>
        <Fragment slot="description">{t('hero-description')}</Fragment>
        <Fragment slot="right">
            <ImageWrapper class={styles.illustration} src="/img/get-involved-banner.svg" alt={t('get-involved-banner')} loading="lazy" />
        </Fragment>
    </Hero>

    {/* Contribute now */}
    <Section
        title={t('contribute-now')}
        containerClass={styles.contributeContainer}
        contentClass={styles.contributeSection}
    >
        <Fragment slot="description">{t('contribute-now-description')}</Fragment>
        <div class={styles.buttonsContainer}>
            <Link class={styles.buttonImageContainer} href="https://play.google.com/store/apps/details?id=org.missingmaps.mapswipe" target="_blank">
                <img class:list={[imageStyles.image, styles.image]} src="/img/playstore.png" alt={t('download-on-playstore')} loading="lazy" />
            </Link>
            <Link class={styles.buttonImageContainer} href="https://apps.apple.com/us/app/mapswipe/id1133855392?ls=1" target="_blank">
                <img class:list={[imageStyles.image, styles.image]} src="/img/apple.png" alt={t('download-on-apple-store')} loading="lazy" />
            </Link>
        </div>
        <div class={styles.linkContainer}>
            <Link class={styles.downloadLink} href="https://web.mapswipe.org/" target="_blank">{t('use-web-app-label')}</Link>
            |
            <Link class={styles.downloadLink} href="https://github.com/mapswipe/mapswipe/releases/latest/download/app-production-release.apk" target="_blank">{t('download-apk-label')}</Link>
        </div>
    </Section>

    {/* Individual */}
    <Section id="individual" class={styles.individual} containerClass={styles.sectionContainer} contentClass={styles.content}>
        <div class={styles.imageContainer}>
            <Heading>{t('individual-heading')}</Heading>
            <ImageWrapper class={styles.illustration} src="/img/individual.svg" alt={t('individual-heading-image')} loading="lazy" />
        </div>
        <div class={styles.cards}>
            <CenteredCard class={styles.card} heading={t('possess-language-skills')}>
                {t('possess-language-skills-description')}
                <Link variant="button" slot="actions"  href="https://explore.transifex.com/mapswipe/" target="_blank">{t('contribute-on-transifex')}</Link>
            </CenteredCard>
            <CenteredCard class={styles.card} heading={t('possess-technical-skills')}>
                {t('possess-techincal-skills-description')}
                <Link variant="button" slot="actions"  href="https://github.com/mapswipe/" target="_blank">{t('contribute-on-github')}</Link>
            </CenteredCard>
        </div>
    </Section>

    {/* Group */}
    <Section class={styles.group} withAlternativeBackground containerClass={styles.sectionContainer} contentClass={styles.content}>
        <div class={styles.cards}>
            <CenteredCard class={styles.card} heading={t('want-to-host-mapswipe-events')}>
                {t('want-to-host-mapswipe-events-description')}
                <Link variant="button" slot="actions"  href="https://drive.google.com/drive/folders/1j5XnyqI_LKYBCg9oJaaWIKbsBxwB8Cld?usp=drive_link" target="_blank">{t('download-toolkit')}</Link>
            </CenteredCard>
            <CenteredCard class={styles.card} heading={t('engage-your-csr')}>
                {t('engage-your-csr-description')}
                <Link variant="button" slot="actions"  href="https://docs.google.com/forms/d/e/1FAIpQLSf_05ZvC4i7HfDgYqedvsPxG66o8SHMaKs1GpnLC9KVFa4FuQ/viewform?usp=sf_link" target="_blank">{t('register-your-interest')}</Link>
            </CenteredCard>
        </div>
        <div class={styles.imageContainer}>
            <Heading>{t('group-heading')}</Heading>
            <ImageWrapper class={styles.illustration} src="/img/group.svg" alt={t('group-heading-image')} loading="lazy" />
        </div>
    </Section>

    {/* Organizational */}
    <Section class={styles.organizational} containerClass={styles.sectionContainer} contentClass={styles.content}>
        <div class={styles.imageContainer}>
            <Heading>{t('organization-heading')}</Heading>
            <ImageWrapper class={styles.illustration} src="/img/organization.svg" alt={t('organization-logo')} loading="lazy" />
        </div>
        <CenteredCard class={styles.card} heading={t('humanitarian-or-nonprofit')}>
            {t('humanitarian-or-nonprofit-description')}
            <Link variant="button" slot="actions"  href="https://docs.google.com/forms/d/e/1FAIpQLSetcSda6EyuvOXMUPe7Gw7wNNIdR9R9RlvOi1j9Zu-C3ZXtbg/viewform?usp=sf_link" target="_blank">{t('tell-us-more')}</Link>
        </CenteredCard>
    </Section>

    {/* Donate */}
    <Section class={styles.donate} withAlternativeBackground containerClass={styles.sectionContainer} contentClass={styles.content}>
        <CenteredCard class={styles.card} heading={t('interested-in-supporting')}>
            <div class={styles.donateCardDescription}>
                <p>{t('interested-in-supporting-description-1')}</p>
                <Link class={styles.downloadLink} href="https://drive.google.com/file/d/1X9Sjys6Qa4Cz16J2cUT87qDejtJNAOOO/view?usp=sharing" target="_blank">{t('download-financial-report')}</Link>
            </div>
            <Link variant="button" slot="actions"  href="https://opencollective.com/mapswipe" target="_blank">{t('donate-now')}</Link>
        </CenteredCard>
        <div class={styles.imageContainer}>
            <Heading>{t('donate-heading')}</Heading>
            <ImageWrapper class={styles.illustration} src="/img/donate.svg" alt={t('donation-logo')} loading="lazy" />
        </div>
    </Section>

    {/* Contact */}
    <Section title={t('contact-section-heading')}>
        <Fragment slot="description">{t('contact-section-description')}</Fragment>
        <Link variant="button" slot="actions"  href="mailto:info@mapswipe.org" target="_blank">{t('contact-link-label')}</Link>
    </Section>
</BaseLayout>
