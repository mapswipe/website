---
import type { GetStaticPaths } from 'astro';
import BaseLayout from 'layouts/BaseLayout.astro';
import DataExplorer, { PAGE_SIZE } from 'components/DataExplorer.tsx';
import ProjectTypeIcon from 'components/ProjectTypeIcon/index.astro';
import Hero from 'components/Hero/index.astro';
import Section from 'components/Section/index.astro';
import Card from 'components/Card/index.astro';
import KeyFigure from 'components/KeyFigure/index.astro';
import Heading from 'components/Heading/index.astro';
import ListItem from 'components/ListItem/index.astro';
import Link from 'components/Link/index.astro';
import ImageWrapper from 'components/ImageWrapper/index.astro';
import { getDataExplorerPayload } from 'lib/dataExplorer';
import { resolveRemoteImage, COVER_WIDTH } from 'lib/remoteImages';
import { getDict, getT, LOCALES } from '../../../i18n';
import { selectPaths } from 'packages/astro-incremental-static/src/index.ts';
// Page module (shared with the DataExplorer island) + the Link/ImageWrapper
// CSS Modules recovered from the Next app; the chrome comes from the shared
// Hero/Section/Card/KeyFigure/Heading/ListItem components. cardStyles is
// still imported for the custom before/after cover slot.
import styles from './styles.module.css';
import cardStyles from 'components/Card/styles.module.css';

// One static page per locale: /<locale>/data/ (parity with the Next Pages-Router
// route src/pages/[locale]/data/index.tsx). trailingSlash:always + directory
// format => dist/<locale>/data/index.html.
//
// This aggregate page's propsData is the FULL data-explorer payload even though
// the page itself SSRs only a slim slice (the first PAGE_SIZE cards +
// stats) and the island fetches the bulk from /data-explorer.json: the SSR'd
// slice (top-N by createdAt) and the stats can shift when ANY project changes,
// so the propsHash must cover the whole payload → the page rebuilds on any
// project change (correct). The SAME payload object is shared across all 6
// locale candidates so it hashes once. When nothing changed under the
// orchestration, selectPaths returns [] and the page is skipped. (The
// /data-explorer.json static endpoint has no getStaticPaths at all, so it
// re-renders on every build and stays fresh regardless.)
export const getStaticPaths = (async () => {
    const payload = getDataExplorerPayload();
    return selectPaths('data', LOCALES.map((locale) => ({
        key: `${locale}/data`,
        params: { locale },
        propsData: payload,
    })));
}) satisfies GetStaticPaths;

const { locale } = Astro.params;

// Locale-independent slimmed payload (built once per page — cheap).
const payload = getDataExplorerPayload();

// The bulky, locale-independent dataset ({miniProjects, organizations,
// imageMap}) ships ONCE as /data-explorer.json — a static file endpoint (see
// src/pages/data-explorer.json.ts) — instead of being inlined into each
// locale's HTML. The island fetches it on mount.
const DATA_EXPLORER_JSON_URL = '/data-explorer.json';

// Initial slice: the first page of projects is SSR'd for SEO/no-blank-page;
// the island fetches the full dataset on mount. Resolve just these cards'
// covers through the build-time fail-soft optimizer (prefetch warmed these
// exact firebase URLs at COVER_WIDTH — pure cache hits).
const initialProjects = payload.projects.slice(0, PAGE_SIZE);
const initialImageMap: Record<string, string> = Object.fromEntries(
    await Promise.all(
        initialProjects
            .map((p) => p.image?.file?.url)
            .filter((url): url is string => Boolean(url))
            .map(async (url) => {
                const { src } = await resolveRemoteImage(url, { width: COVER_WIDTH });
                return [url, src] as const;
            }),
    ),
);

// Resolve the `data` namespace for THIS locale into a plain {key:string} dict
// and hand it to the island as a prop. Keeps the i18next runtime out of the
// island bundle. Raw templates (interpolation intact) so the island does its
// own tiny interpolation for the few dynamic keys.
const dict = await getDict(locale!, 'data');
const t = await getT(locale!, 'data');

const title = String(t('data-tab-head'));

// Community stats (static, matching the Next page's statsHeader section).
const { totalSwipes, totalContributors } = payload;
// Compact ("217M", "137K") — parity with Next's <NumberOutput normal />.
const fmt = (n: number | null | undefined) =>
    (n == null ? '-' : new Intl.NumberFormat('en-US', { notation: 'compact', compactDisplay: 'short' }).format(n));

// Static type-explainer cards (mirrors the Next page's type-section: cover
// image + ProjectTypeIcon + heading + key-point list).
const typeCards = [
    { type: 'FIND', coverImageUrl: '/img/find.svg', title: t('type-find-title'), points: [t('type-find-key-point-1'), t('type-find-key-point-2'), t('type-find-key-point-3')] },
    { type: 'COMPARE', beforeAfter: true, title: t('type-compare-title'), points: [t('type-compare-key-point-1'), t('type-compare-key-point-2'), t('type-compare-key-point-3')] },
    { type: 'VALIDATE', coverImageUrl: '/img/validate.svg', title: t('type-validate-title'), points: [t('type-validate-key-point-1'), t('type-validate-key-point-2'), t('type-validate-key-point-3')] },
    { type: 'COMPLETENESS', coverImageUrl: '/img/completeness.png', title: t('type-completeness-title'), points: [t('type-completeness-key-point-1'), t('type-completeness-key-point-2'), t('type-completeness-key-point-3')] },
    { type: 'VALIDATE_IMAGE', coverImageUrl: '/img/validate_image.png', title: t('type-validate-image-title'), points: [t('type-validate-image-key-point-1'), t('type-validate-image-key-point-2'), t('type-validate-image-key-point-3')] },
    { type: 'STREET', coverImageUrl: '/img/street_image.png', title: t('type-streets-view-title'), points: [t('type-street-key-point-1'), t('type-street-key-point-2'), t('type-street-key-point-3')] },
    { type: 'LOCATE', coverImageUrl: '/img/locate_image.svg', title: t('type-locate-title'), points: [t('type-locate-key-point-1'), t('type-locate-key-point-2'), t('type-locate-key-point-3')] },
] as const;
---
<BaseLayout
    locale={locale!}
    title={title}
    path="data/"
    activePath="data"
    mainClass={styles.data}
>
    {/* Hero */}
    <Hero title={t('data-page-heading')}>
        <Fragment slot="description">{t('data-page-description')}</Fragment>
        <Fragment slot="right">
            <ImageWrapper
                class={styles.illustration}
                src="/img/data-banner.svg"
                alt={t('data-banner-image')}
                loading="lazy"
            />
        </Fragment>
    </Hero>

    {/* Community stats (Next: statsHeader Section with circle KeyFigures) */}
    <Section contentClass={styles.statsHeader}>
        <div class={styles.leftContent}>
            <KeyFigure
                variant="circle"
                class={[styles.figure, styles.largeFigure]}
                value={fmt(totalSwipes)}
            >
                {t('total-swipes')}
            </KeyFigure>
            <KeyFigure
                variant="circle"
                circleColor="complement"
                class={styles.figure}
                value={fmt(totalContributors)}
            >
                {t('contributors')}
            </KeyFigure>
        </div>
        <div class={styles.rightContent}>
            <Heading class={styles.heading}>
                {t('community-stats-section-heading')}
            </Heading>
            <div class={styles.sectionDescription}>
                {t('community-stats-section-description')}
                <Link
                    variant="underline"
                    href="https://community.mapswipe.org"
                    target="_blank"
                    rel="noreferrer"
                >
                    {t('community-dashboard-link-label')}
                </Link>
            </div>
        </div>
    </Section>

    {/* Project-type explainer cards (static, SSR-only) */}
    <Section
        withAlternativeBackground
        class={styles.typeSection}
        title={t('type-section-heading')}
        contentClass={styles.typeList}
    >
        <Fragment slot="description">{t('type-section-description')}</Fragment>
        {typeCards.map((card) => (
            <Card
                as="article"
                heading={card.title}
                coverImageUrl={'coverImageUrl' in card ? card.coverImageUrl : undefined}
                coverWrapperClass={styles.missionImage}
                childrenContainerClass={styles.keyPointList}
            >
                {'beforeAfter' in card && card.beforeAfter && (
                    <div
                        slot="cover"
                        class:list={[cardStyles.coverImageWrapper, styles.missionImage, styles.beforeAfterContainer]}
                    >
                        <ImageWrapper
                            class={styles.beforeAfterImageWrapper}
                            imageClass={styles.beforeImage}
                            src="/img/before.svg"
                            alt="before-image"
                            loading="lazy"
                            decoding="async"
                        />
                        <ImageWrapper
                            class={styles.beforeAfterImageWrapper}
                            imageClass={styles.afterImage}
                            src="/img/after.svg"
                            alt="after-image"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                )}
                <Fragment slot="icons"><ProjectTypeIcon type={card.type} /></Fragment>
                {card.points.map((p) => (
                    <ListItem>{p}</ListItem>
                ))}
            </Card>
        ))}
    </Section>

    {/* The ONE interactive island: filters + search + sort + pagination +
       card list + map share state. client:load so filters + initial list
       are in the SSR'd HTML; the leaflet map is client-guarded inside.
       Renders the explore + download sections with the same recovered
       CSS-Module classes as the old Next page (it imports this page's
       styles.module.css). */}
    <DataExplorer
        client:load
        dict={dict}
        locale={locale!}
        imageMap={initialImageMap}
        initialProjects={initialProjects}
        totalCount={payload.projects.length}
        dataUrl={DATA_EXPLORER_JSON_URL}
        globalExportAssets={payload.globalExportAssets}
        minArea={payload.minArea}
        maxArea={payload.maxArea}
        minContributors={payload.minContributors}
        maxContributors={payload.maxContributors}
        buildDate={payload.buildDate}
    />

    {/* License + contact (static) */}
    <Section title={t('license-section-heading')}>
        <Fragment slot="description">{t('license-section-description')}</Fragment>
    </Section>
    <Section
        withAlternativeBackground
        title={t('contact-section-heading')}
    >
        <Fragment slot="description">{t('contact-section-description')}</Fragment>
        <Link
            variant="button"
            slot="actions"
            href="mailto:info@mapswipe.org"
            target="_blank"
        >
            {t('contact-link-label')}
        </Link>
    </Section>
</BaseLayout>
