---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DataExplorer, { PAGE_SIZE } from '../../../components/DataExplorer.tsx';
import { getDataExplorerPayload } from '../../../lib/dataExplorer';
import { resolveRemoteImage, COVER_WIDTH } from '../../../lib/remoteImages';
import { getDict, getT, LOCALES } from '../../../i18n';
import { selectPaths } from '../../../../packages/astro-incremental-static/src/index.ts';
import '../../../styles/global.css';

// One static page per locale: /<locale>/data/ (parity with the Next Pages-Router
// route src/pages/[locale]/data/index.tsx). trailingSlash:always + directory
// format => dist/<locale>/data/index.html.
//
// This aggregate page's propsData is the FULL data-explorer payload even though
// the page itself SSRs only a slim slice (the first PAGE_SIZE cards +
// stats) and the island fetches the bulk from /data-explorer.json: the SSR'd
// slice (top-N by createdAt) and the stats can shift when ANY project changes,
// so the propsHash must cover the whole payload → the page rebuilds on any
// project change (correct). The SAME payload object is shared across all 6
// locale candidates so it hashes once. When nothing changed under the
// orchestration, selectPaths returns [] and the page is skipped. (The
// /data-explorer.json static endpoint has no getStaticPaths at all, so it
// re-renders on every build and stays fresh regardless.)
export const getStaticPaths = (async () => {
  const payload = getDataExplorerPayload();
  return selectPaths('data', LOCALES.map((locale) => ({
    key: `${locale}/data`,
    params: { locale },
    propsData: payload,
  })));
}) satisfies GetStaticPaths;

const { locale } = Astro.params;

// Locale-independent slimmed payload (built once per page — cheap).
const payload = getDataExplorerPayload();

// The bulky, locale-independent dataset ({miniProjects, organizations,
// imageMap}) ships ONCE as /data-explorer.json — a static file endpoint (see
// src/pages/data-explorer.json.ts) — instead of being inlined into each
// locale's HTML. The island fetches it on mount.
const DATA_EXPLORER_JSON_URL = '/data-explorer.json';

// Initial slice: the first page of projects is SSR'd for SEO/no-blank-page;
// the island fetches the full dataset on mount. Resolve just these cards'
// covers through the build-time fail-soft optimizer (prefetch warmed these
// exact firebase URLs at COVER_WIDTH — pure cache hits).
const initialProjects = payload.projects.slice(0, PAGE_SIZE);
const initialImageMap: Record<string, string> = Object.fromEntries(
  await Promise.all(
    initialProjects
      .map((p) => p.image?.file?.url)
      .filter((url): url is string => Boolean(url))
      .map(async (url) => {
        const { src } = await resolveRemoteImage(url, { width: COVER_WIDTH });
        return [url, src] as const;
      }),
  ),
);

// Resolve the `data` namespace for THIS locale into a plain {key:string} dict
// and hand it to the island as a prop. Keeps the i18next runtime out of the
// island bundle. Raw templates (interpolation intact) so the island does its
// own tiny interpolation for the few dynamic keys.
const dict = await getDict(locale!, 'data');
const t = await getT(locale!, 'data');

const title = String(t('data-tab-head'));

// Static type-explainer cards (mirrors the Next page's type-section).
const typeCards = [
  { key: 'find', title: t('type-find-title'), points: [t('type-find-key-point-1'), t('type-find-key-point-2'), t('type-find-key-point-3')] },
  { key: 'compare', title: t('type-compare-title'), points: [t('type-compare-key-point-1'), t('type-compare-key-point-2'), t('type-compare-key-point-3')] },
  { key: 'validate', title: t('type-validate-title'), points: [t('type-validate-key-point-1'), t('type-validate-key-point-2'), t('type-validate-key-point-3')] },
  { key: 'completeness', title: t('type-completeness-title'), points: [t('type-completeness-key-point-1'), t('type-completeness-key-point-2'), t('type-completeness-key-point-3')] },
  { key: 'validate_image', title: t('type-validate-image-title'), points: [t('type-validate-image-key-point-1'), t('type-validate-image-key-point-2'), t('type-validate-image-key-point-3')] },
  { key: 'street', title: t('type-streets-view-title'), points: [t('type-street-key-point-1'), t('type-street-key-point-2'), t('type-street-key-point-3')] },
  { key: 'locate', title: t('type-locate-title'), points: [t('type-locate-key-point-1'), t('type-locate-key-point-2'), t('type-locate-key-point-3')] },
];
---
<BaseLayout locale={locale!} title={title} path="data/" activePath="data" mainClass="data-page">
      <!-- Hero -->
      <section class="hero">
        <div class="heroMain">
          <h1>{t('data-page-heading')}</h1>
          <p>{t('data-page-description')}</p>
        </div>
      </section>

      <!-- Project-type explainer cards (static, SSR-only) -->
      <section class="section">
        <h2>{t('type-section-heading')}</h2>
        <p>{t('type-section-description')}</p>
        <div class="type-list">
          {typeCards.map((card) => (
            <article class="type-card">
              <h3>{card.title}</h3>
              <ul>
                {card.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- The ONE interactive island: filters + search + sort + pagination +
           card list + map share state. client:load so filters + initial list
           are in the SSR'd HTML; the leaflet map is client-guarded inside. -->
      <DataExplorer
        client:load
        dict={dict}
        imageMap={initialImageMap}
        initialProjects={initialProjects}
        totalCount={payload.projects.length}
        dataUrl={DATA_EXPLORER_JSON_URL}
        globalExportAssets={payload.globalExportAssets}
        minArea={payload.minArea}
        maxArea={payload.maxArea}
        minContributors={payload.minContributors}
        maxContributors={payload.maxContributors}
        totalContributors={payload.totalContributors}
        totalSwipes={payload.totalSwipes}
        buildDate={payload.buildDate}
      />

      <!-- License + contact (static) -->
      <section class="section">
        <h2>{t('license-section-heading')}</h2>
        <p>{t('license-section-description')}</p>
      </section>
      <section class="section">
        <h2>{t('contact-section-heading')}</h2>
        <p>{t('contact-section-description')}</p>
        <a class="de-btn" href="mailto:info@mapswipe.org" target="_blank">{t('contact-link-label')}</a>
      </section>
</BaseLayout>
<style is:global>
      .data-page { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
      .type-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin-top: 1rem; }
      .type-card { border: 1px solid #eee; border-radius: 8px; padding: 1rem; }
      .type-card h3 { margin-top: 0; }

      /* DataExplorer island */
      .de-stats-header { display: flex; gap: 2rem; flex-wrap: wrap; align-items: center; margin: 2rem 0; }
      .de-figures { display: flex; gap: 1.5rem; }
      .de-figure { display: flex; flex-direction: column; align-items: center; }
      .de-figure-value { font-size: 1.8rem; font-weight: 700; color: var(--color-accent); }
      .de-figure-large .de-figure-value { font-size: 2.4rem; }
      .de-figure-label { font-size: 0.85rem; color: #666; }
      .de-stats-copy { flex: 1 1 320px; }

      .de-explore { margin-top: 2.5rem; }
      .de-explore-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
      .de-last-fetched { font-size: 0.8rem; color: #888; }

      .de-top { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 1.5rem; margin-top: 1rem; }
      @media (max-width: 800px) { .de-top { grid-template-columns: 1fr; } }
      /* .de-filters is a <fieldset> (so `disabled` cascades to every filter
         control while the dataset JSON loads) — reset the fieldset chrome. */
      .de-filters { display: flex; flex-direction: column; gap: 0.75rem; border: 0; padding: 0; margin: 0; min-inline-size: auto; }
      .de-filters:disabled { opacity: 0.6; }
      .de-fieldset { border: 1px solid #eee; border-radius: 8px; padding: 0.5rem 0.75rem; margin: 0; }
      .de-fieldset legend { font-size: 0.8rem; color: #666; padding: 0 0.3rem; }
      .de-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .de-chip { display: inline-flex; align-items: center; gap: 0.3rem; border: 1px solid #ccc; background: #fff; border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.8rem; cursor: pointer; }
      .de-chip-on { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
      .de-input { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 6px; font-size: 0.9rem; }
      .de-row { display: flex; gap: 0.5rem; }
      .de-date { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.75rem; color: #666; flex: 1; }
      .de-btn { border: 1px solid var(--color-primary); background: #fff; color: var(--color-primary); border-radius: 6px; padding: 0.5rem 0.9rem; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
      .de-clear { align-self: flex-start; }

      .de-map-container { display: flex; flex-direction: column; gap: 0.5rem; }
      .de-map { height: 420px; border-radius: 8px; overflow: hidden; }
      .de-map-placeholder { height: 100%; background: #eef1f2; }
      .de-map-settings { display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; }
      .de-radio { display: inline-flex; align-items: center; gap: 0.3rem; }

      .de-summary { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0; font-size: 0.95rem; }
      .de-dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; display: inline-block; }
      .de-dot-active { background: #F69143; }
      .de-dot-finished { background: #AABE5D; }

      .de-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
      .de-card-link { text-decoration: none; color: inherit; }
      .de-card { border: 1px solid #eee; border-radius: 10px; overflow: hidden; height: 100%; display: flex; flex-direction: column; }
      .de-card-img { width: 100%; height: 160px; object-fit: cover; }
      .de-card-body { padding: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .de-card-heading { margin: 0; font-size: 1.05rem; }
      .de-card-tags, .de-card-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .de-tag { display: inline-flex; align-items: center; gap: 0.3rem; background: #f2f2f2; border-radius: 999px; padding: 0.15rem 0.55rem; font-size: 0.78rem; }
      .de-tag-plain { background: transparent; padding: 0.15rem 0; color: #666; }
      .de-progress { margin-top: auto; }
      .de-progress-track { background: #eee; border-radius: 999px; height: 8px; overflow: hidden; }
      .de-progress-bar { background: var(--color-accent); height: 100%; }
      .de-progress-label { font-size: 0.75rem; color: #666; margin-top: 0.2rem; }

      .de-download { margin-top: 2.5rem; }
      .de-download-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
      .de-download-card { padding: 1rem; }
      .de-file-details { display: flex; gap: 0.5rem; align-items: center; margin: 0.5rem 0; font-size: 0.85rem; color: #666; }
      .de-link { color: var(--color-primary); font-weight: 600; text-decoration: none; }
      .de-popup-link { text-decoration: none; color: inherit; }
      .de-popup-tags { display: flex; gap: 0.3rem; margin-top: 0.3rem; }
</style>
