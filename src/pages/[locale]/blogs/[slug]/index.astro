---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BlogLayout from 'layouts/BlogLayout.astro';
import Icon from 'components/Icon.astro';
import { getT, LOCALES } from '../../../../i18n';
import { selectPaths } from 'packages/astro-incremental-static/src/index.ts';
// CSS Modules recovered from the Next app: the page module + the component
// modules whose markup this page reproduces (Hero, Section, Tag, Heading,
// HtmlOutput, ImageWrapper).
import styles from './styles.module.css';
import heroStyles from 'components/Hero.module.css';
import sectionStyles from 'components/Section.module.css';
import tagStyles from 'components/Tag.module.css';
import headingStyles from 'components/Heading.module.css';
import imageStyles from 'components/ImageWrapper.module.css';
import htmlOutputStyles from 'components/HtmlOutput.module.css';

// Blog DETAIL page. getStaticPaths = 6 locales x N blogs, producing
// /<locale>/blogs/<slug>/ with exact URL parity to Next (slug == entry.id ==
// path.parse(filename).name). Markdown body is rendered by Astro's pipeline
// (remark-gfm enabled in astro.config.mjs); in-body relative images
// (./images/*) are optimized natively by astro:assets.
//
// propsHash = the entry's stable frontmatter fields + raw markdown body, so
// only posts whose content/frontmatter changed are rebuilt. The cover hashes
// as its emitted `src` string (content-hashed by astro:assets) — the full
// resolved image() metadata object is NOT hashed (it can carry non-portable
// absolute paths). All 6 locale variants of a post share the SAME signature
// object so it hashes once.
export const getStaticPaths = (async () => {
    const entries = await getCollection('blogs');
    const candidates = entries.flatMap((entry) => {
        const signature = {
            id: entry.id,
            title: entry.data.title ?? null,
            publishedDate: entry.data.publishedDate?.getTime() ?? null,
            author: entry.data.author ?? null,
            description: entry.data.description ?? null,
            featured: entry.data.featured ?? false,
            coverImage: entry.data.coverImage?.src ?? null,
            body: entry.body ?? '',
        };
        return LOCALES.map((locale) => ({
            key: `${locale}/blogs/${entry.id}`,
            params: { locale, slug: entry.id },
            props: { entry },
            propsData: signature,
        }));
    });
    return selectPaths('blogs-detail', candidates);
}) satisfies GetStaticPaths;

const { locale } = Astro.params;
const { entry } = Astro.props;
const t = await getT(locale!, 'blog');

const { title, publishedDate, author, coverImage, description } = entry.data;
const blogTitle = title ?? entry.id;

// Render the collection entry's markdown body to HTML (Next's equivalent:
// remark().use(remark-html).use(remark-gfm)). remark-gfm is applied via the
// project markdown config.
const { Content } = await render(entry);

// {{date, datetime}} parity: Intl.DateTimeFormat(lng), default options.
const dateFmt = new Intl.DateTimeFormat(locale!);

const tabTitle = String(t('blog-tab-head', { blogTitle }));
---
<BlogLayout
    locale={locale!}
    title={tabTitle}
    description={description}
    path={`blogs/${entry.id}/`}
    mainClass={styles.blog}
>
    {/* Hero: title + date/author tags left, cover image right */}
    <div class:list={[heroStyles.hero, styles.hero]}>
        <div class={heroStyles.section}>
            <div class:list={[heroStyles.mainContent, styles.heroMainContent]}>
                <div class:list={[heroStyles.left, styles.heroLeftContent]}>
                    <h2 class:list={[headingStyles.heading, headingStyles.extraLarge, heroStyles.heading]}>
                        {blogTitle}
                    </h2>
                    <div class={heroStyles.description}>
                        <div class={styles.heroDescription}>
                            {publishedDate && (
                                <span class:list={[tagStyles.tag, tagStyles.transparent, styles.heroTag]}>
                                    <Icon name="calendar-clear-outline" />
                                    {dateFmt.format(publishedDate)}
                                </span>
                            )}
                            {author && (
                                <span class:list={[tagStyles.tag, tagStyles.transparent, styles.heroTag]}>
                                    {author}
                                </span>
                            )}
                        </div>
                    </div>
                </div>
                <div class={heroStyles.right}>
                    {coverImage ? (
                        <div class:list={[imageStyles.imageWrapper, styles.illustration]}>
                            <Image class={imageStyles.image} src={coverImage} alt={blogTitle} width={800} loading="lazy" decoding="async" />
                        </div>
                    ) : (
                        <div />
                    )}
                </div>
            </div>
        </div>
        <div class={heroStyles.angledBackground}></div>
    </div>

    <section class={sectionStyles.section}>
        <div class={sectionStyles.container}>
            <div class={htmlOutputStyles.htmlOutput}>
                <Content />
            </div>
        </div>
    </section>
</BlogLayout>
