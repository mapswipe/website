---
// spacing defaults to medium like the Next Tag — it applied its spacing map
// unconditionally, so every rendered tag carried a spacing class.
import styles from 'components/Tag/styles.module.css';

type Variant = 'primary' | 'transparent' | 'border' | 'icon';
type Spacing = 'small' | 'medium' | 'large';

interface Props {
    variant?: Variant;
    spacing?: Spacing | 'none';
    class?: string;
    title?: string;
}

const {
    variant = 'primary',
    spacing = 'medium',
    class: className,
    title,
} = Astro.props;

const variantMap: Record<Variant, string | undefined> = {
    primary: undefined,
    transparent: styles.transparent,
    border: styles.border,
    icon: styles.icon,
};
const spacingMap: Record<Spacing, string> = {
    small: styles.small,
    medium: styles.medium,
    large: styles.large,
};
---
<span
    class:list={[styles.tag, variantMap[variant], spacing !== 'none' && spacingMap[spacing], className]}
    title={title}
><slot /></span>
