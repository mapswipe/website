---
// Slots are rendered eagerly so absent content also drops its wrapper div
// (parity with the Next component, which only emitted the wrappers when the
// prop was set).
import styles from 'components/Section/styles.module.css';
import Heading from 'components/Heading/index.astro';

interface Props {
    id?: string;
    title?: string;
    class?: string;
    containerClass?: string;
    contentClass?: string;
    descriptionClass?: string;
    actionsClass?: string;
    withAlternativeBackground?: boolean;
}

const {
    id,
    title,
    class: className,
    containerClass,
    contentClass,
    descriptionClass,
    actionsClass,
    withAlternativeBackground = false,
} = Astro.props;

// Trimmed emptiness checks: the default slot renders leftover whitespace even
// when a caller only fills named slots — that must not emit a stray wrapper.
const description = Astro.slots.has('description') ? await Astro.slots.render('description') : '';
const actions = Astro.slots.has('actions') ? await Astro.slots.render('actions') : '';
const content = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
---
<section
    id={id}
    class:list={[styles.section, withAlternativeBackground && styles.withAlternativeBackground, className]}
>
    <div class:list={[styles.container, containerClass]}>
        {(title || description.trim()) && (
            <div class={styles.headingContainer}>
                {title && <Heading class={styles.heading}>{title}</Heading>}
                {description.trim() && (
                    <div
                        class:list={[styles.description, descriptionClass]}
                        set:html={description}
                    />
                )}
            </div>
        )}
        {content.trim() && (
            <div
                class={contentClass}
                set:html={content}
            />
        )}
        {actions.trim() && (
            <div
                class:list={[styles.actions, actionsClass]}
                set:html={actions}
            />
        )}
    </div>
</section>
