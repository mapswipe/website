---
// Link (port of the Next components/Link, minus next/link's client routing —
// static pages only need a styled anchor). Extra attributes (href, target,
// rel, title, download, …) pass straight through to the element.
import type { HTMLAttributes } from 'astro/types';
import styles from 'components/Link.module.css';

type Variant = 'transparent' | 'button' | 'buttonTransparent' | 'icon' | 'underline';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
    variant?: Variant;
    // string or a class:list-style array (falsy entries dropped)
    class?: string | (string | false | null | undefined)[];
}

const { variant = 'transparent', class: className, ...rest } = Astro.props;
// `slot` on a component is placement metadata for the parent, but Astro also
// leaves it in props — it must not be spread onto the element.
delete rest.slot;

const variantMap: Record<Variant, string | undefined> = {
    transparent: undefined,
    button: styles.button,
    buttonTransparent: styles.buttonTransparent,
    icon: styles.icon,
    underline: styles.underline,
};
---
<a class:list={[styles.link, variantMap[variant], className]} {...rest}><slot /></a>
