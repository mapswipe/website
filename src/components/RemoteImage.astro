---
// Thin wrapper over astro-remote-images' component: importing the app config
// module first guarantees the package's default instance is OUR configured
// one (fail-soft optimize, error-image policy, COVER_WIDTH default width).
import '../lib/remoteImages';
import RemoteImage from 'astro-remote-images/RemoteImage.astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}
---
<RemoteImage {...Astro.props} />
