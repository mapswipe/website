---
// Key figure (port of the Next components/KeyFigure): big value + plus icon
// over a label (default slot). box (default) or circle variant.
import styles from 'components/KeyFigure.module.css';
import Icon from 'components/Icon.astro';

interface Props {
    value: string | number;
    variant?: 'box' | 'circle';
    circleColor?: 'accent' | 'complement';
    // string or a class:list-style array (falsy entries dropped)
    class?: string | (string | false | null | undefined)[];
}

const {
    value,
    variant = 'box',
    circleColor = 'accent',
    class: className,
} = Astro.props;
---
<div class:list={[styles.keyFigure, variant === 'circle' && styles.circle, circleColor === 'complement' && styles.complement, className]}>
    <div class={styles.value}>
        {value}
        <Icon name="plus" class={styles.icon} />
    </div>
    <div class={styles.label}><slot /></div>
</div>
